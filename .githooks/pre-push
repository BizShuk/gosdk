#!/bin/bash
#
# 強制 CLAUDE.md 的「版本規則」中可機械驗證的部分。
# 只檢查推往 master/main 的分支推送；feature branch 與 tag 推送直接放行。
#
# 檢查項目：
#   1. VERSION 相對遠端有遞增
#   2. major 未被遞增（breaking change 需人為介入，用 --no-verify 繞過）
#   3. tag v<VERSION> 存在且指向被推送的 commit
#   4. .claude-plugin/plugin.json 的 version 與 VERSION 一致
#
# 啟用：git config core.hooksPath .githooks

set -uo pipefail

readonly VERSION_FILE="VERSION"
readonly LEGACY_VERSION_FILE="version" # 2026-07 重命名前的檔名
readonly PLUGIN_FILE=".claude-plugin/plugin.json"
readonly ZERO_SHA="0000000000000000000000000000000000000000"

fail() {
	echo "pre-push: $1" >&2
	shift
	for line in "$@"; do
		echo "           $line" >&2
	done
	echo "           （確定要略過請用 git push --no-verify）" >&2
	exit 1
}

# 從指定 commit 讀出版本字串；相容重命名前的 `version` 檔名。
version_at() {
	local sha="$1"
	git show "${sha}:${VERSION_FILE}" 2>/dev/null ||
		git show "${sha}:${LEGACY_VERSION_FILE}" 2>/dev/null
}

# 驗證 major.minor.patch 格式，回傳正規化後的字串。
parse_semver() {
	local raw
	raw="$(echo "$1" | tr -d '[:space:]')"
	[[ "$raw" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || return 1
	echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"
}

# 比較兩組 semver：new 嚴格大於 old 回傳 0，否則 1。
is_greater() {
	local -a n o
	read -ra n <<<"$1"
	read -ra o <<<"$2"
	for i in 0 1 2; do
		((n[i] > o[i])) && return 0
		((n[i] < o[i])) && return 1
	done
	return 1
}

check_push() {
	local local_sha="$1" remote_sha="$2"

	local raw_new
	raw_new="$(version_at "$local_sha")" ||
		fail "找不到 ${VERSION_FILE}" "commit ${local_sha:0:7} 中沒有版本檔"

	local new
	new="$(parse_semver "$raw_new")" ||
		fail "${VERSION_FILE} 格式錯誤：'${raw_new}'" "應為 major.minor.patch"

	local version="${new// /.}"

	# 檢查 1 & 2：與遠端比較。新分支（remote 為 zero sha）無從比較，略過。
	if [[ "$remote_sha" != "$ZERO_SHA" ]]; then
		local raw_old old
		raw_old="$(version_at "$remote_sha")"
		if old="$(parse_semver "${raw_old:-}")"; then
			local -a n o
			read -ra n <<<"$new"
			read -ra o <<<"$old"

			if ((n[0] > o[0])); then
				fail "major 版本不可自動遞增（${old// /.} → ${version}）" \
					"major 屬 breaking change，須經人為明確決定"
			fi

			if ! is_greater "$new" "$old"; then
				fail "${VERSION_FILE} 未遞增（遠端已是 ${old// /.}）" \
					"每次更新都必須遞增 minor 或 patch：" \
					"  go run ./cmd/versioning patch   # 或 minor"
			fi
		fi
	fi

	# 檢查 3：tag 必須存在且指向這次推送的 commit。
	if ! git tag --points-at "$local_sha" | grep -Fxq "v${version}"; then
		fail "commit ${local_sha:0:7} 上找不到 tag v${version}" \
			"  git tag -a v${version} -m 'Release v${version}'" \
			"  git push origin master --follow-tags"
	fi

	# 檢查 4：plugin.json 必須同步。
	local plugin_version
	plugin_version="$(git show "${local_sha}:${PLUGIN_FILE}" 2>/dev/null |
		sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"

	if [[ -n "$plugin_version" && "$plugin_version" != "$version" ]]; then
		fail "${PLUGIN_FILE} 版本不同步（${plugin_version} ≠ ${version}）" \
			"plugin.json 的 version 欄位必須與 ${VERSION_FILE} 一致"
	fi
}

while read -r _local_ref local_sha remote_ref remote_sha; do
	# 刪除分支：無內容可檢查。
	[[ "$local_sha" == "$ZERO_SHA" ]] && continue
	# 只管 master/main；tag 與 feature branch 放行。
	[[ "$remote_ref" == "refs/heads/master" || "$remote_ref" == "refs/heads/main" ]] || continue

	check_push "$local_sha" "$remote_sha"
done

exit 0
